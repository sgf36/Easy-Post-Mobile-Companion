# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Build outputs that land under store/ during packaging and screenshot runs.
# Named exactly, with trailing slashes, so they cannot catch the committed
# store/asc-shots-<lang>/ sets — an earlier run swept an .aab and a retired
# screenshot set into the index because nothing here excluded them.
store/android-release/
store/asc-shots/

# store/play-assets/ used to be ignored wholesale, which meant the Play listing
# imagery lived only on whichever machine last captured it while the App Store
# equivalents were tracked. That is how a set captured against the live account
# survived unnoticed until it was read: nothing ever showed it in a diff.
# Ignore the binaries that get swept in, not the listing itself.
store/**/*.aab
store/**/*.apk
store/**/*.bak
